{
  "name": "crank-mem",
  "version": "0.14.0",
  "private": true,
  "description": "Project memory for coding agents: anatomy index, cerebrum, session injection.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard",
    "test": "bun test --parallel=4 --path-ignore-patterns='dashboard/**' --path-ignore-patterns='**/*.serial.test.ts'; p=$?; bun test .serial.test.ts; s=$?; [ $p -eq 0 ] && [ $s -eq 0 ]",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:health": "knip && fallow health --complexity --no-cache -q",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.0.0",
    "fallow": "3.42.0",
    "knip": "6.45.1",
    "oxfmt": "0.76.0",
    "typescript": "^5.8.0"
  }
}
